rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection & private trip_history subcollection
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /trip_history/{tripId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if isSignedIn()
        && (
          resource.data.hostUid == request.auth.uid
          || request.auth.uid in resource.data.memberUids
          || (
            resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && request.auth.uid in request.resource.data.memberUids
          )
        );
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
